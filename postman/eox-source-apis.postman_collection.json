            ],
            "url": "https://sdmx.oecd.org/public/rest/data/OECD.SDD.TPS,DSD_PRICES_COICOP2018@DF_PRICES_C2018_N_TXCP01_NRG,1.0/{{iso3}}.M.N.CPI.PA._TXCP01_NRG.N.GY?startPeriod={{startMonth}}&format=csvfile",
            "description": "Used by 22 pilot countries as of 2026-09. Returns 404 NoRecordsFound for countries still on the original classification (e.g. USA)."
          }
