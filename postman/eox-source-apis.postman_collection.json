{
  "info": {
    "name": "EOX source APIs",
    "description": "The external requests behind the EOX ingestion pipelines (packages/ingestion). Every pilot-country indicator that is proven for all 30 countries is covered. Change the collection variables to inspect a different country, date or start period. Ingestion queries all 30 countries at once by joining ISO codes with '+'; these requests use one country for readability.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "iso3",
      "value": "USA",
      "description": "ISO 3166-1 alpha-3 code, used by PortWatch and OECD"
    },
    {
      "key": "iso2",
      "value": "US",
      "description": "ISO 3166-1 alpha-2 code, used by BIS"
    },
    {
      "key": "date",
      "value": "2026-09-25",
      "description": "PortWatch observation date (YYYY-MM-DD); use the latest available date request to find it"
    },
    {
      "key": "startYear",
      "value": "2021",
      "description": "First year requested from BIS policy rates"
    },
    {
      "key": "startMonth",
      "value": "2021-01",
      "description": "First month requested from monthly OECD flows"
    },
    {
      "key": "startQuarter",
      "value": "2021-Q1",
      "description": "First quarter requested from quarterly OECD and BIS flows"
    }
  ],
  "item": [
    {
      "name": "#6 Container Throughput - IMF PortWatch",
      "description": "Script: ingest:container-throughput. Public ArcGIS FeatureServer, no key. Estimated container tonnage per port; ingestion sums ports that report both import and export estimates.",
      "item": [
        {
          "name": "Latest available date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the latest date', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.be.undefined;",
                  "  const date = body.features[0].attributes.date;",
                  "  pm.expect(date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "  pm.collectionVariables.set('date', date);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://services9.arcgis.com/weJ1QsnbMYJlCHdG/arcgis/rest/services/Daily_Ports_Data/FeatureServer/0/query?where=import_container IS NOT NULL&outFields=date&f=json&resultRecordCount=1&orderByFields=date DESC&returnGeometry=false",
            "description": "Most recent date with container estimates. Ingestion uses this when no date is given. The test stores the result in the date collection variable, so the next request uses it."
          }
        },
        {
          "name": "Ports for one country and date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ArcGIS features without error', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.be.undefined;",
                  "  pm.expect(body.features).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.exceededTransferLimit).to.not.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://services9.arcgis.com/weJ1QsnbMYJlCHdG/arcgis/rest/services/Daily_Ports_Data/FeatureServer/0/query?where=ISO3 = '{{iso3}}' AND date = DATE '{{date}}'&outFields=date,ISO3,portid,portcalls_container,import_container,export_container&f=json&resultRecordCount=1000&orderByFields=ObjectId&returnGeometry=false",
            "description": "One request per country, so each country total links to a single stored payload. Ingestion fails if exceededTransferLimit is true."
          }
        }
      ]
    },
    {
      "name": "#17 Real Estate Valuation - BIS",
      "description": "Script: ingest:residential-property-price. Indicator residential_property_price_real.",
      "item": [
        {
          "name": "Real residential property prices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('SDMX CSV with observations', () => {",
                  "  const head = pm.response.text().slice(0, 1000);",
                  "  pm.expect(head).to.include('TIME_PERIOD');",
                  "  pm.expect(head).to.include('OBS_VALUE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://stats.bis.org/api/v1/data/WS_SPP/Q.{{iso2}}.R.628?startPeriod={{startQuarter}}&format=csv",
            "description": "Quarterly, real (CPI-deflated) index, 2010 = 100 (VALUE=R, UNIT_MEASURE=628). format=csv is required; Accept: text/csv alone returns XML."
          }
        }
      ]
    },
    {
      "name": "#21 Real GDP Vintages - OECD",
      "description": "Script: ingest:gdp-real-volume. Indicator gdp_real_volume, stored in millions of national currency.",
      "item": [
        {
          "name": "Real GDP archive editions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('SDMX CSV with observations', () => {",
                  "  const head = pm.response.text().slice(0, 1000);",
                  "  pm.expect(head).to.include('TIME_PERIOD');",
                  "  pm.expect(head).to.include('OBS_VALUE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "en",
                "description": "Required. The OECD server returns HTTP 500 for uncached queries sent with Accept-Language: * (the Node fetch default)."
              }
            ],
            "url": "https://sdmx.oecd.org/public/rest/data/OECD.SDD.STES,DSD_STES_REVISIONS@DF_STES_REVISIONS,4.0/{{iso3}}.Q.B1GQ_Q...?startPeriod={{startQuarter}}&format=csvfile",
            "description": "Main Economic Indicators monthly archive. EDITION (YYYYMM) is the vintage; B1GQ_Q is real volume in national currency (XDC)."
          }
        }
      ]
    },
