            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200, or 404 when this country uses the other classification', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('SDMX CSV with observations', () => {",
                  "    const head = pm.response.text().slice(0, 1000);",
