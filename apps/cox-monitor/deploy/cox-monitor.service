[Unit]
Description=COX monitor (read-only archive checks and verdicts; holds no key)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cox-monitor
Group=cox-monitor
WorkingDirectory=/opt/cox-monitor/current
Environment=EVIDENCE_API_URL=http://127.0.0.1:8787
Environment=MONITOR_HOST=127.0.0.1
Environment=MONITOR_PORT=8792
Environment=MONITOR_STATE=/var/lib/cox-monitor/state.json
Environment=MONITOR_INTERVAL_SECONDS=20
Environment=MONITOR_PAGE_SIZE=5
Environment=MONITOR_MAX_PAGES=1
ExecStart=/usr/bin/node /opt/cox-monitor/current/monitor.mjs
Restart=on-failure
RestartSec=5
StateDirectory=cox-monitor
UMask=0077
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cox-monitor
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
