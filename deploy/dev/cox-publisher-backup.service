[Unit]
Description=Back up COX publication history and recovery journal
After=network-online.target
[Service]
Type=oneshot
User=cox-publisher
Group=cox-publisher
ExecStart=/opt/cox-publisher/runtime/node-v24.21.0-linux-x64/bin/node /opt/cox-publisher/cox-publication-backup.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cox-publisher
TimeoutStartSec=120
