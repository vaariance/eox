[Unit]
Description=COX app API (live source over the devnet cox program)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eox
Group=eox
WorkingDirectory=/opt/eox/app/apps/app-api
Environment=APP_API_HOST=127.0.0.1
Environment=APP_API_PORT=8791
Environment=APP_API_SOURCE=cox-live
Environment=COX_NETWORK=solana-devnet
Environment=COX_POOL_ID=0
Environment=COX_RPC_URLS=https://api.devnet.solana.com
Environment=APP_API_STATE_DIR=/opt/eox/state/cox-app-api-live
Environment=COX_PUBLICATION_ARCHIVE=/opt/eox/state/cox-publication-archive
EnvironmentFile=-/opt/eox/cox-app-api-live.env
ExecStart=/opt/eox/app/apps/app-api/node_modules/.bin/tsx src/main.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
